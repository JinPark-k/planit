KAKAO_JS_KEY=

# 배포된 백엔드. 백엔드를 로컬에서 띄우지 않아도 앱이 동작한다.
API_BASE_URL=https://planit-backend-omega.vercel.app

# 로컬 백엔드로 테스트하려면 이 파일은 건드리지 않는다.
# 대신 apps/mobile/.env.local.example을 복사해 .env.local을 만들고,
# `pnpm --filter @planit/mobile ios:local` (또는 android:local)로 실행한다.
# 이 파일(.env)은 항상 운영 주소를 가리켜야 한다 — 아카이브/릴리스 빌드가 이 파일을 쓰기 때문에,
# 여기를 로컬 주소로 바꿔둔 채 잊으면 배포된 앱이 localhost를 보게 된다.
