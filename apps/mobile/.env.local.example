KAKAO_JS_KEY=

# 로컬 백엔드. ENVFILE=.env.local 로 명시적으로 선택했을 때만 쓰인다.
# (기본값은 항상 .env의 운영 주소 — 아무 옵션 없이 빌드하면 .env가 쓰인다.)
#   iOS 시뮬레이터   : http://localhost:3001   (호스트와 localhost를 공유)
#   Android 에뮬레이터: http://10.0.2.2:3001   (에뮬레이터에서 호스트 PC는 10.0.2.2)
# 포트는 3001을 기본으로 쓴다 (3000은 다른 용도로 쓰일 수 있음).
API_BASE_URL=http://localhost:3001

# 주의: react-native-config는 ENVFILE로 지정한 파일을 통째로 갈아끼운다.
# .env와 자동으로 합쳐지지 않으므로, 여기 없는 키는 .env.local을 쓰는 동안 그냥 빈 값이 된다.
# 위 KAKAO_JS_KEY를 지우지 말 것 — 지우면 로컬 빌드에서 카카오맵이 조용히 빈 값으로 동작한다.
