# deps
node_modules/
.pnpm-store/

# env
# .env.example만 커밋한다. 실제 값이 든 파일은 전부 무시.
# (특히 .env.production에는 Supabase service_role 키가 들어가므로 반드시 제외)
.env
.env.*
!.env.example
apps/*/.env
apps/*/.env.*
!apps/*/.env.example

# backend (Nest)
apps/backend/dist/

# mobile - iOS
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/ios/*.xcworkspace/xcuserdata/
apps/mobile/ios/DerivedData/

# mobile - Android
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/local.properties
apps/mobile/android/.cxx/
apps/mobile/android/keystores/*.jks

# supabase (CLI 로컬 상태/임시 파일)
supabase/.temp/
supabase/.branches/

# misc
*.log
.DS_Store
.vscode/
