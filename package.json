{
  "name": "planit",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @planit/backend start:dev",
    "dev:mobile:ios": "pnpm --filter @planit/mobile ios",
    "dev:mobile:android": "pnpm --filter @planit/mobile android",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "batch:run": "pnpm --filter @planit/backend batch:run",
    "batch:run:prod": "pnpm --filter @planit/backend batch:run:prod",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push:prod": "supabase db push",
    "scan:secrets": "secretlint --secretlintrc .secretlintrc.json \"**/*\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-1password": "^13.0.4",
    "@secretlint/secretlint-rule-anthropic": "^13.0.4",
    "@secretlint/secretlint-rule-aws": "^13.0.4",
    "@secretlint/secretlint-rule-basicauth": "^13.0.4",
    "@secretlint/secretlint-rule-cloudflare": "^13.0.4",
    "@secretlint/secretlint-rule-database-connection-string": "^13.0.4",
    "@secretlint/secretlint-rule-databricks": "^13.0.4",
    "@secretlint/secretlint-rule-docker": "^13.0.4",
    "@secretlint/secretlint-rule-figma": "^13.0.4",
    "@secretlint/secretlint-rule-filter-comments": "^13.0.4",
    "@secretlint/secretlint-rule-gcp": "^13.0.4",
    "@secretlint/secretlint-rule-github": "^13.0.4",
    "@secretlint/secretlint-rule-gitlab": "^13.0.4",
    "@secretlint/secretlint-rule-grafana": "^13.0.4",
    "@secretlint/secretlint-rule-groq": "^13.0.4",
    "@secretlint/secretlint-rule-hashicorp-vault": "^13.0.4",
    "@secretlint/secretlint-rule-huggingface": "^13.0.4",
    "@secretlint/secretlint-rule-linear": "^13.0.4",
    "@secretlint/secretlint-rule-notion": "^13.0.4",
    "@secretlint/secretlint-rule-npm": "^13.0.4",
    "@secretlint/secretlint-rule-openai": "^13.0.4",
    "@secretlint/secretlint-rule-pattern": "^13.0.4",
    "@secretlint/secretlint-rule-privatekey": "^13.0.4",
    "@secretlint/secretlint-rule-sendgrid": "^13.0.4",
    "@secretlint/secretlint-rule-shopify": "^13.0.4",
    "@secretlint/secretlint-rule-slack": "^13.0.4",
    "@secretlint/secretlint-rule-stripe": "^13.0.4",
    "@secretlint/secretlint-rule-tailscale": "^13.0.4",
    "@secretlint/secretlint-rule-vercel": "^13.0.4",
    "husky": "^9.1.7",
    "secretlint": "^13.0.4"
  }
}
